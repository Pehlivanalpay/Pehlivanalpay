# İletişim formu — Resend (https://resend.com). Yayında zorunlu.
# Yoksa geliştirme modunda mesaj e-posta yerine sunucu günlüğüne yazılır.
RESEND_API_KEY=
# Alıcı (varsayılan: info@elis360news.com)
CONTACT_TO=
# Gönderen — Resend'de doğrulanmış alan adından olmalı
CONTACT_FROM="ELIS360 NEWS Web <form@elis360news.com>"

# Kanonik site adresi — canonical, Open Graph, sitemap, JSON-LD bunu kullanır.
# Varsayılan: https://elis360news.com (e-posta alan adından türetildi, doğrulanmalı)
NEXT_PUBLIC_SITE_URL=https://elis360news.com
