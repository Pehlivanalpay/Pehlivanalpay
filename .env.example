# İletişim formu — kurumun kendi posta sunucusu (SMTP). Yayında zorunlu.
# Yoksa geliştirme modunda mesaj e-posta yerine sunucu günlüğüne yazılır.
# Bilgileri e-posta sağlayıcınızın "SMTP / e-posta istemcisi ayarları" sayfasından alın.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@elis360news.com
SMTP_PASS=
# Alıcı (varsayılan: info@elis360news.com)
CONTACT_TO=
# Gönderen (varsayılan: SMTP_USER). Çoğu sunucu yalnızca giriş yapılan adresten göndermeye izin verir.
CONTACT_FROM=

# Kanonik site adresi — canonical, Open Graph, sitemap, JSON-LD bunu kullanır.
NEXT_PUBLIC_SITE_URL=https://elis360news.com

# WordPress (haber) — kurulum: wordpress/README.md
# Tanımlı değilken yerelde ve ön izlemede örnek veri kullanılır; canlıda haber bölümleri gizlenir.
WP_URL=https://cms.elis360news.com/wp
# wp-config.php'deki ELIS360_WEBHOOK_SECRET ile aynı (yayın bildirimi + bülten kaydı)
WP_WEBHOOK_SECRET=
# wp-config.php'deki ELIS360_PREVIEW_SECRET ile aynı
WP_PREVIEW_SECRET=
# Taslak önizleme: WordPress kullanıcı adı + Profil → Uygulama Parolaları
WP_PREVIEW_USER=
WP_PREVIEW_APP_PASSWORD=
