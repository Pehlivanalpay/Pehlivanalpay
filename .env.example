# İletişim formu — kurumun kendi posta sunucusu (SMTP). Yayında zorunlu.
# Yoksa geliştirme modunda mesaj e-posta yerine sunucu günlüğüne yazılır.
# Bilgileri e-posta sağlayıcınızın "SMTP / e-posta istemcisi ayarları" sayfasından alın.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@elis360news.com
SMTP_PASS=
# Alıcı (varsayılan: info@elis360news.com)
CONTACT_TO=
# Gönderen (varsayılan: SMTP_USER). Çoğu sunucu yalnızca giriş yapılan adresten göndermeye izin verir.
CONTACT_FROM=

# Kanonik site adresi — canonical, Open Graph, sitemap, JSON-LD bunu kullanır.
NEXT_PUBLIC_SITE_URL=https://elis360news.com
